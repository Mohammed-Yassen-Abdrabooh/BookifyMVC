@model IEnumerable<AuthorViewModel>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
@{
    ViewData["Title"] = "Authors";
}

@section PluginsStyle {
    <link rel="stylesheet" href="~/assets/plugins/datatables/datatables.bundle.css" />
}

<div class="alert bg-light-primary border border-primary border-3 border-dashed d-flex justify-content-between align-items-center flex-sm-row w-100 p-5 mb-10">
    <div class=" d-flex align-items-center">
        <!--begin::Icon-->
        <div class="symbol symbol-40px me-4">
            <div class="symbol-label fs-2 fw-semibold text-success">
                <!--begin::Svg Icon | path: icons/duotune/general/gen002.svg-->
                <span class="svg-icon svg-icon-2 svg-icon-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-vcard" viewBox="0 0 16 16">
                        <path d="M5 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4m4-2.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5M9 8a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4A.5.5 0 0 1 9 8m1 2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5" />
                        <path d="M2 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H8.96q.04-.245.04-.5C9 10.567 7.21 9 5 9c-2.086 0-3.8 1.398-3.984 3.181A1 1 0 0 1 1 12z" />
                    </svg>
                </span>
                <!--end::Svg Icon-->
            </div>
        </div>
        <!--end:Icon-->
        <!--begin::Content-->
        <div class="pe-0 pe-sm-10">
            <h3 class="mb-1">Authors</h3>
        </div>
        <!--end::Content-->
    </div>
    <!--begin::Add btn-->

    <div class="card-toolbar">
        <a href="javascript:;" class="btn btn-sm btn-primary js-render-modal"
           data-title="Add Author" data-url="/Author/Create">
            <i class="bi bi-plus-square-dotted"></i>
            Add
        </a>
    </div>
    <!--end::Add btn-->
</div>



<div class="card shadow-sm">
    <partial name="_DataTableCardHeader"/>
    <div class="card-body pt-0">
        <!-- Remove Check on The Model if(!Model.Any()) because The DataTable Will Do it -->
        <div class="table-responsive">
            <table class="table table-row-dashed table-row-gray-300 gy-2 align-middle js-datatables" data-document-title="Authors">
                <thead>
                    <tr class="fw-bold fs-6 text-gray-800">
                        <th>Name</th>
                        <th>Status</th>
                        <th>Created On</th>
                        <th>Last Updated On</th>
                        <th class="js-no-export text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var author in Model)
                    {

                        <partial name="_AuthorRow" model="author" />
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<input type="hidden" name="__RequestVerificationToken" value="@antiforgery.GetAndStoreTokens(Context).RequestToken" />

@section Plugins {
    <script src="~/assets/plugins/datatables/datatables.bundle.js"></script>
}


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <!--Handel Js Code Which Written here in View To Write it in External Js File and Put only Reference Here-->
    <!-- move The Configuration For DataTable to site.js to Modify in one Place and Not Repeat Code in another Modules -->
    <!-- move The Code For ToggleStatus From External File To The General in site.js because it do it only and can i Use it ia another Modules without Repeat it -->
    <!-- Now I Dont need This External File And i Delete it becaues i Moved Contains code To site.js
        <script src="~/assets/js/category.js" asp-append-version="true"></script>
    -->
}


