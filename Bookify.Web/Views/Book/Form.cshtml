@model BooksFormViewModel
@{
    ViewData["title"] = "Book Form";
}

<div class="card shadow-sm">
    <!--Start Card Header-->
    <div class="card-header">
        <h3 class="card-title">@(Model.Id.Equals(0) ? "Add" : "Edit") Book</h3>
    </div>
    <!--End Card Header-->
    <!--Start Card Body-->
    <div class="card-body">
        <!--enctype="multipart/form-data" ==> To Take Uploaded Files By Form-->
        <form method="post" asp-controller="Book" enctype="multipart/form-data" id="Form">
            @if (Model.Id > 0)
            {
                <input type="hidden" asp-for="Id" />
            }
            <div class="mb-5">
                <!--begin::Image input-->
                <div class="image-input image-input-empty" data-kt-image-input="true" style="background-image: url(@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/image-placeholder.png" : Model.ImageThumbnailUrl )); background-position: center;)">
                    <!--begin::Image preview wrapper-->
                    <div class="image-input-wrapper w-125px h-200px" style="background-position:center;"></div>
                    <!--end::Image preview wrapper-->
                    <!--begin::Edit button-->
                    <label class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                           data-kt-image-input-action="change"
                           data-bs-dismiss="click">
                        <i class="bi bi-pencil-fill fs-7"></i>

                        <!--begin::Inputs-->
                        <input type="file" asp-for="Image" accept=".png, .jpg, .jpeg, .gif" />
                        <input type="hidden" name="avatar_remove" />
                        <!--end::Inputs-->
                    </label>
                    <!--end::Edit button-->
                    <!--begin::Cancel button-->
                    <span class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                          data-kt-image-input-action="cancel"
                          data-bs-dismiss="click">
                        <i class="bi bi-x fs-2"></i>
                    </span>
                    <!--end::Cancel button-->
                    <!--begin::Remove button-->
                    <span class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                          data-kt-image-input-action="remove"
                          data-bs-dismiss="click">
                        <i class="bi bi-x fs-2"></i>
                    </span>
                    <!--end::Remove button-->
                </div>
                <div class="form-text">Allowed File Types: " png, jpeg, jpg, gif " and Cannot be more than 2 MB</div>
                <span asp-validation-for="Image" class="text-danger d-block"></span>
                <!--end::Image input-->
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <div class="form-floating mb-2">
                                    <input type="text" class="form-control form-control-solid" asp-for="Title" placeholder="Title For New Book" />
                                    <label asp-for="Title"></label>
                                </div>
                                <span asp-validation-for="Title" class="ms-3 text-danger d-block"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <div class="form-floating mb-2">
                                    <select class="form-select form-select-solid js-select2" data-placeholder="Select an Author" asp-for="AuthorId" asp-items="@Model.Authors">
                                        <option value="">Select an Author</option>
                                    </select>
                                    <label asp-for="AuthorId"></label>
                                </div>
                                <span asp-validation-for="AuthorId" class="ms-3 text-danger d-block"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <div class="mb-2">
                                    <select class="form-select form-select-solid js-select2" data-placeholder ="Select Categories" asp-for="SelectedCategories" asp-items="@Model.Categories">
                                        <option value="">Select Category</option>
                                    </select>
                                </div>
                                <span asp-validation-for="SelectedCategories" class="ms-3 text-danger d-block"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <div class="form-floating mb-2">
                                    <input type="text" class="form-control form-control-solid" asp-for="Publisher" placeholder="Publisher Name" />
                                    <label asp-for="Publisher"></label>
                                </div>
                                <span asp-validation-for="Publisher" class="ms-3 text-danger d-block"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <div class="form-floating mb-2">
                                    <!--Conver input Type from Date To text ==> To Use DateRangePicker Library Which isnstalled in Metronic Theme-->
                                    <input type="text" class="form-control form-control-solid js-dateRangePicker" asp-for="PublishingDate" placeholder="Publishing Date" />
                                    <label asp-for="PublishingDate"></label>
                                </div>
                                <span asp-validation-for="PublishingDate" class="ms-3 text-danger d-block"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col">
                            <div class="form-check form-switch form-check-solid form-check-custom  mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="IsAvailableForRental" />
                                <label class="form-check-label" asp-for="IsAvailableForRental"></label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <div class="form-floating mb-2">
                                    <input type="text" class="form-control form-control-solid" asp-for="Hall" placeholder="Hall Place" />
                                    <label asp-for="Hall"></label>
                                </div>
                                <span asp-validation-for="Hall" class="ms-3 text-danger d-block"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <div class="form-floating mb-2">
                                    <textarea class="form-control form-control-solid js-tinymce" placeholder="Write a Description For Book" asp-for="Description"></textarea>
                                    <label asp-for="Description"></label>
                                </div>
                                <span asp-validation-for="Description" class="ms-3 text-danger d-block"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>          
        </form>
    </div>
    <!--End Card Body-->
    <!--Start Card Footer-->
    <div class="card-footer">
        <button type="submit" class="btn btn-primary" form="Form">
            <span class="indicator-label">
                Save
            </span>
            <span class="indicator-progress">
                Please wait... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
        </button>
        <a class="btn btn-light text-primary ms-3" asp-action="Index">Cancel</a>
    </div>
    <!--End Card Footer-->
</div>
@section Scripts {
<script src="~/assets/plugins/tinymce/tinymce.bundle.js"></script>
    <partial name="_ValidationScriptsPartial" />

}