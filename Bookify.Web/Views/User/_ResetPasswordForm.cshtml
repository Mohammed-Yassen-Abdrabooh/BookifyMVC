@model ResetPasswordFormViewModel

<form asp-controller="User"
      data-ajax-method="post"
      data-ajax="true"
      data-ajax-begin="OnModalBegin"
      data-ajax-success="OnModalSuccess"
      data-ajax-failure="ShowErrorMessage"
      data-ajax-complete="OnModalComplete">


    <input type="hidden" asp-for="Id" />
    <!--begin::Input group-->
    <div class="mb-3">
        <div class="form-floating mb-2">
            <input type="password" class="form-control form-control-solid " asp-for="Password" placeholder="New Password" />
            <label asp-for="Password"></label>
        </div>
        <span asp-validation-for="Password" class="ms-3 text-danger d-block"></span>
    </div>
    <div class="mb-3">
        <div class="form-floating mb-2">
            <input type="password" class="form-control form-control-solid " asp-for="ConfirmPassword" placeholder="ReWrite The Password" />
            <label asp-for="ConfirmPassword"></label>
        </div>
        <span asp-validation-for="ConfirmPassword" class="ms-3 text-danger d-block"></span>
    </div>
    @*     <button class="btn btn-primary rounded-pill" type="submit">
        <i class="bi bi-check2"></i>
        Save
    </button> *@
    <partial name="_ModalFooterBtn" />
    <!--end::Input group-->
</form>

