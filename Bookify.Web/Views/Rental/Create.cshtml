@model RentalFormViewModel
@{
    ViewData["Title"] = "Create Rental";
}

<!--begin::Card-->
<div class="card mb-7">
    <!--begin::Card header-->
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title">Add Rental</h3>
        <div>
            <a class="btn btn-sm p-3 btn-primary" asp-controller="Subscriber" asp-action="Details" asp-route-id="@Model.SubscriberKey">
                <i class="bi fs-2 bi-arrow-bar-left"></i>
                Go Back
            </a>
        </div>
    </div>
    <!--End::Card header-->
    <!--begin::Card body-->
    <div class="card-body">
        <partial name="_SearchForm" model="new SearchFormViewModel()" />
    </div>
    <!--end::Card body-->
    <div class="card mb-5 mb-xl-8">
        <!--begin::Header-->
        <div class="card-header border-0 pt-5">
            <h3 class="card-title align-items-start flex-column">
                <span class="card-label fw-bold text-gray-900">Books</span>
                <span class="text-muted mt-1 fw-semibold fs-7">You can add up to @((int) RentalsConfiguration.MaxNumberOfCopiesPerRental) books</span>
            </h3>
        </div>
        <!--end::Header-->
        <!--begin::Body-->
        <div class="card-body pt-5">
            <form asp-action="Create" id="CopiesFormForCreateNewRental">
                <input type="hidden" asp-for="SubscriberKey"/>
                @*Copies Will be Added Here*@ <!--I'm No Rendered Partial View Here Because i Will PreAppend The Row Usg JQ in rentalForm.js-->
                <!--begin::Submit Btn Using Loading Spinner-->
                <button type="submit" class="btn btn-primary">
                    <span class="indicator-label">
                        Save
                    </span>
                    <span class="indicator-progress">
                        Please wait... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>

                </button>
                <!--End::Submit Btn Using Loading Spinner-->

            </form>
        </div>
        <!--end::Body-->
    </div>

</div>
<!--end::Card-->

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script>
        var maxAllowedCopies = @((int)RentalsConfiguration.MaxNumberOfCopiesPerRental);
    </script>
    <script src="~/js/rentalform.js" asp-append-version="true"></script>
}