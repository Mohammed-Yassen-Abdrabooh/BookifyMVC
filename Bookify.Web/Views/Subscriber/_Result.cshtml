@model SubscriberSearchResultViewModel

<div class="card shadow-sm">
    <!--begin::Card body-->
    <div class="card-body">
        @if (Model is null)
        {
            <div class="alert bg-light-warning border border-warning border-3 border-dashed d-flex justify-content-between align-items-center flex-sm-row w-100 p-5">
                <!--begin::Content-->
                <div class="d-flex flex-column pe-0 pe-sm-10">
                    <span class="mb-1 fw-bold fs-4">No Subscriber Were Found!</span>
                </div>
                <div>
                    <a asp-action="Create" class="btn btn-primary align-items-center mt-2">Add Subscriper</a>
                </div>
                <!--end::Content-->
            </div>
        }
        else
        {
            <div class="d-flex justify-content-evenly align-items-center">
                <div>
                    <div class="symbol symbol-100px">
                        <img src="@Model.ImageThumbnailUrl" alt="Subscriber Image" />
                    </div>
                </div>
                <div class="d-flex flex-column">
                    <h4 class="mb-3">@Model.FullName</h4>
                    <div>
                        <a class="btn btn-primary" asp-action="Details" asp-route-id="@Model.Key">Details</a>
                    </div>
                </div>
            </div>
        }

    </div>
    <!--end::Card body-->
</div>



